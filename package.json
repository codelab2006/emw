{
  "name": "emw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "src/electron"
  ],
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "install:all": "node scripts/install-all.mjs",
    "clean:all": "node scripts/clean-all.mjs",
    "build": "npm run build:electron && npm run build:windows && node scripts/build-renderer-config.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "electron dist"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "prettier": "3.9.6",
    "tree-kill": "1.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
